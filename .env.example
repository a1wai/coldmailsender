# ============================================================================
# Cold Email Sender — built by @a1wai
# Copy this file to `.env.local` for local dev, or paste the values into
# Vercel → Project → Settings → Environment Variables for production.
#
# EVERY variable below is OPTIONAL. The app runs with an empty .env.local:
# credentials can be typed into the UI (Tab 4) and leads live in your browser.
# Set these when you would rather keep secrets on the server than in a browser.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. SMTP / Gmail  (optional — otherwise configured in Tab 4 of the UI)
# ----------------------------------------------------------------------------
# When these are set, the server uses them and the browser never has to hold
# your app password. UI-supplied credentials take precedence when provided.
#
# Gmail requires an APP PASSWORD, not your normal account password:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create an app password:     https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below (spaces are fine, they get stripped).
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
# Defaults target Gmail. Override for Zoho, Brevo, Mailgun, Resend SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Optional reply-to address if replies should land somewhere else.
SMTP_REPLY_TO=


# ----------------------------------------------------------------------------
# 2. Compliance & deliverability  (READ THIS ONE — it is why mail lands in spam)
# ----------------------------------------------------------------------------
# Physical mailing address appended to the footer. Required by CAN-SPAM in the
# US and equivalent rules elsewhere.
SENDER_POSTAL_ADDRESS=

# One-click unsubscribe (RFC 8058).
#
# Since February 2024 Google, Yahoo and Apple all expect outreach mail to carry
# a List-Unsubscribe-Post header, and that is defined over HTTPS only — a
# mailto: opt-out does not satisfy it. This app hosts the endpoint itself at
# /api/unsubscribe, so the only thing it needs is to know its own public URL.
#
# On Vercel that is detected automatically and you can leave this blank. Set it
# for a custom domain, or when running behind a proxy.
UNSUBSCRIBE_BASE_URL=

# Signs the opt-out links so a forged one cannot add addresses to your list.
# Strongly recommended. Generate with:  openssl rand -hex 32
UNSUBSCRIBE_SECRET=

# Where mailto: opt-out replies go. Defaults to your SMTP_USER.
UNSUBSCRIBE_EMAIL=
# Only set this if you host your own unsubscribe page. It overrides the
# built-in /api/unsubscribe endpoint entirely.
UNSUBSCRIBE_URL=


# ----------------------------------------------------------------------------
# 3. Claude  (optional — the ONE paid part of this app)
# ----------------------------------------------------------------------------
# Two optional features use this key:
#   1. AI contact extraction — Claude reads each crawled page and picks the
#      right person (name + role), instead of just any matching address.
#   2. "Write it with Claude" in the template wizard.
# Both have free fallbacks: the regex crawler and the local template builder.
#
# Be aware: the Anthropic API is PAID and has no permanent free tier, unlike
# everything else in this project. A template generation costs a fraction of a
# cent, but it is not zero. Leave this blank to stay entirely free.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=


# ----------------------------------------------------------------------------
# 4. Google Places  (optional — the fix for "Maps shows more than this app does")
# ----------------------------------------------------------------------------
# Without this, businesses come from OpenStreetMap: free forever, no key, but
# volunteer-mapped and much thinner than Google in most regions. That gap is
# why a Maps search by hand turns up forty businesses and the app finds three.
#
# With a key, the app queries the Places API (New) — Google's own sanctioned
# route to the same index Maps uses. This is not scraping: harvesting Maps or
# Search results breaks Google's terms and gets blocked in practice, which is
# why this app has never done it.
#
# Billed per search past a recurring monthly credit, so like ANTHROPIC_API_KEY
# this is a paid opt-in. Enable "Places API (New)" in the Google Cloud console,
# restrict the key to that API, and set a budget alert.
# https://console.cloud.google.com/google/maps-apis
GOOGLE_PLACES_API_KEY=


# ----------------------------------------------------------------------------
# 5. Firecrawl  (optional — free tier, deeper JS-rendered scraping)
# ----------------------------------------------------------------------------
# Free tier: https://firecrawl.dev  (no card required)
# Leave blank to use the built-in axios + cheerio scraper only.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev


# ----------------------------------------------------------------------------
# 6. Upstash QStash  (optional — free tier, serverless background queue)
# ----------------------------------------------------------------------------
# Free tier: https://upstash.com/pricing/qstash  (500 messages/day)
# Without this, the browser drives the send loop (works fine; keep the tab open).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public HTTPS URL QStash should call back. On Vercel this is your deployment
# URL, e.g. https://your-app.vercel.app  (must be reachable from the internet).
QSTASH_CALLBACK_BASE_URL=


# ----------------------------------------------------------------------------
# 7. Supabase  (optional — free Postgres tier for persisting leads/campaigns)
# ----------------------------------------------------------------------------
# Free tier: https://supabase.com/pricing
# Run `supabase/schema.sql` in the Supabase SQL editor after creating a project.
# Leave blank to keep everything in browser LocalStorage + JSON export.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key. NEVER prefix this one with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# ----------------------------------------------------------------------------
# 8. Scraper tuning  (optional)
# ----------------------------------------------------------------------------
# Respect robots.txt. Only set to false for sites you own or are authorised to
# crawl — see the Responsible Use section of the README.
SCRAPER_RESPECT_ROBOTS=true
# Per-page HTTP timeout in milliseconds.
SCRAPER_TIMEOUT_MS=12000
# Default pages followed per site. The UI overrides this per search (1–15).
SCRAPER_MAX_PAGES=6
# User-Agent sent while crawling. Identify yourself honestly.
SCRAPER_USER_AGENT=ColdMailSenderBot/1.0 (+https://github.com/a1wai/coldmailsender)

# Comma-separated Overpass mirrors, tried in order. The defaults are the public
# instances, which are free, donation-funded and regularly busy — "OpenStreetMap
# timed out" almost always means one of them was overloaded, not that anything
# is broken. Override this to use a different mirror or your own instance.
# Default: https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
OVERPASS_ENDPOINTS=
